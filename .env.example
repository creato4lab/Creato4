# ============================================================
# Creato4 Lab — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
# ============================================================

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database (Neon PostgreSQL) ──────────────────────────────
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# ─── Auth.js / NextAuth ─────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-strong-random-secret-here"
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ─── Razorpay Payment Gateway ───────────────────────────────
RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_XXXXXXXXXXXXXX"

# ─── Email (Gmail App Password) ─────────────────────────────
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-gmail-app-password"
EMAIL_FROM="Creato4 Lab <your-email@gmail.com>"

# ─── Cloudflare R2 (Secure File Delivery) ───────────────────
R2_ACCOUNT_ID="your-r2-account-id"
R2_BUCKET_NAME="creato4-digital-assets"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# ─── Admin Configuration ────────────────────────────────────
ADMIN_EMAILS="creato4lab@gmail.com"

# ─── Analytics (Optional — add before launch) ───────────────
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_CLARITY_ID=""
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""
